{
  "version": 2,
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/render-article.js": {
      "includeFiles": "article.html"
    },
    "api/render-index.js": {
      "includeFiles": "index.html"
    }
  },
  "headers": [
    {
      "source": "/(login.html|analytics|dashboard|admin|api/admin-stats|api/scrape|api/comments|api/sys/.*|roster.html|roster_lineup.js|opinion_admin.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(style.css|logo.png|favicon.png|favicon.ico|images/.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(site.webmanifest|manifest.json)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|news-sitemap.xml|feed.xml|api/sitemap|api/news-sitemap|api/feed)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/api/articles",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=30, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/podosfairo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/basket",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/erasitexnis",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/apopsi",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/matches.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/agones",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sport-latest.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/news-sitemap"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/basket",
      "destination": "/api/render-index?category=basket"
    },
    {
      "source": "/podosfairo",
      "destination": "/api/render-index?category=football"
    },
    {
      "source": "/erasitexnis",
      "destination": "/api/render-index?category=erasitexnis"
    },
    {
      "source": "/erasitechnis",
      "destination": "/api/render-index?category=erasitexnis"
    },
    {
      "source": "/apopsi",
      "destination": "/api/render-index?category=apopsi"
    },
    {
      "source": "/analytics",
      "destination": "/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/login.html"
    },
    {
      "source": "/admin",
      "destination": "/login.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/fixtures",
      "destination": "/fixtures.html"
    },
    {
      "source": "/schedule",
      "destination": "/fixtures.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/roster",
      "destination": "/roster.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service.html"
    },
    {
      "source": "/site.webmanifest",
      "destination": "/api/webmanifest"
    },
    {
      "source": "/manifest.json",
      "destination": "/api/webmanifest"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:category/:slug",
      "destination": "/api/render-article?slug=:slug"
    },
    {
      "source": "/:category/:slug-id=:id",
      "destination": "/api/render-article?id=:id"
    },
    {
      "source": "/",
      "destination": "/api/render-index"
    }
  ]
}