{
  "version": 2,
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/render-article.js": {
      "includeFiles": "article.html"
    },
    "api/render-index.js": {
      "includeFiles": "index.html"
    },
    "api/render-admin.js": {
      "includeFiles": "login.html"
    }
  },
  "headers": [
    {
      "source": "/(login.html|analytics|dashboard|admin|api/admin-stats|api/scrape|api/comments|api/sys/.*|roster.html|roster_lineup.js|opinion_admin.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/podosfairo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/basket",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/erasitexnis",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/apopsi",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/matches.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/agones",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sport-latest.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    },
    {
      "source": "/feed",
      "destination": "/api/feed"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/basket",
      "destination": "/api/render-index?category=basket"
    },
    {
      "source": "/podosfairo",
      "destination": "/api/render-index?category=football"
    },
    {
      "source": "/erasitexnis",
      "destination": "/api/render-index?category=erasitexnis"
    },
    {
      "source": "/erasitechnis",
      "destination": "/api/render-index?category=erasitexnis"
    },
    {
      "source": "/apopsi",
      "destination": "/api/render-index?category=apopsi"
    },
    {
      "source": "/login.html",
      "destination": "/api/render-admin"
    },
    {
      "source": "/analytics",
      "destination": "/api/render-admin"
    },
    {
      "source": "/dashboard",
      "destination": "/api/render-admin"
    },
    {
      "source": "/admin",
      "destination": "/api/render-admin"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/fixtures",
      "destination": "/fixtures.html"
    },
    {
      "source": "/schedule",
      "destination": "/fixtures.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/roster",
      "destination": "/roster.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service.html"
    },
    {
      "source": "/site.webmanifest",
      "destination": "/api/webmanifest"
    },
    {
      "source": "/manifest.json",
      "destination": "/api/webmanifest"
    },
    {
      "source": "/(podosfairo|basket|erasitexnis|erasitechnis|apopsi|genika|pao)/:slug",
      "destination": "/api/render-article?slug=:slug"
    },
    {
      "source": "/(podosfairo|basket|erasitexnis|erasitechnis|apopsi|genika|pao)/:slug-id=:id",
      "destination": "/api/render-article?id=:id"
    },
    {
      "source": "/",
      "destination": "/api/render-index"
    }
  ]
}